# Copy this file to system-health-monitor.env and fill in real values.
#   cp system-health-monitor.env.example system-health-monitor.env
# The .env file is git-ignored so your secrets never get committed.

# Stable session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-64-char-hex-string

# Dashboard login — CHANGE THESE.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# Where the SQLite history/alerts database lives.
DB_PATH=/home/pi/System-Health-Monitor/monitor.db
