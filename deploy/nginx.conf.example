# Optional reverse proxy so you can reach the dashboard on port 80 (or add HTTPS).
# Copy to /etc/nginx/sites-available/system-health-monitor, then:
#   sudo ln -s /etc/nginx/sites-available/system-health-monitor /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name _;            # or your Pi's hostname / domain

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # Required for Socket.IO / WebSocket upgrades
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;   # keep long-lived websocket connections open
    }
}
